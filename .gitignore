# Environment — never commit secrets
.env
.env.*

# Service account keys — a committed key is a live credential to the
# participant data bucket, readable in history even after deletion.
key.json
*-key.json
service-account*.json
*.pem

# Participant roster — contains login PINs. Supplied to deployments via the
# PARTICIPANT_CONFIG_JSON environment variable instead of being committed.
participant_config.json

# Claude Code
CLAUDE.md
.claude/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
venv/
*.ipynb_checkpoints

# Node / Vite (both frontends)
node_modules/
frontend/dist/
frontend-participant/dist/

# macOS
.DS_Store

# Output directories
plots/
reports/
newplot/

# Large data files
*.csv
*.avro
*.parquet
.vercel
.env*
